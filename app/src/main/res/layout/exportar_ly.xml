<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorBtn"
    android:gravity="center_horizontal"
    android:layout_height="fill_parent"
    android:orientation="vertical">

    <LinearLayout

        android:padding="15dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0dp">


        <LinearLayout
            android:layout_marginEnd="10dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/targeta">







            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:text="Exportar Config:"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Payload"/>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:gravity="end"
                android:layout_height="fill_parent">
                <ImageView
                    android:id="@+id/hadsButton3"
                    android:src="@drawable/salir"
                    android:layout_width="15dp"
                    android:layout_height="fill_parent"/>
            </LinearLayout>




        </LinearLayout>




        <LinearLayout
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ffffff">

        </LinearLayout>




    </LinearLayout>



    <LinearLayout

        android:paddingBottom="15dp"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        >





        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">




            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#00000000"
                android:text="Seleccione una opcion entre Nube y Local."
                android:textColor="#ffffff" />





            <TextView
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nube:"
                android:textSize="15dp"
                android:textColor="@color/blue_light"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:text="Guarda el archivo en la nube."
                android:textColor="#ffffff" />







            <TextView
                android:layout_marginTop="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/blue_light"
                android:textStyle="bold"
                android:textSize="15dp"
                android:text="Local:"
                 />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guarda el archivo en la memoria interna del telefono."
                android:textColor="#ffffff" />



















        </LinearLayout>


        <LinearLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">


            <LinearLayout

                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="0dp"
                android:orientation="horizontal">

            <Button
                android:drawableLeft="@drawable/ic_nubeshared"
                android:layout_marginEnd="10dp"
                android:id="@+id/hadsButton1"
                android:layout_height="wrap_content"
                app:backgroundTint="@color/cardcolor"
                android:layout_width="fill_parent"
                android:text="Nube"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="#ffffff" />


            <Button
                android:drawableLeft="@drawable/ic_localshared"
                android:id="@+id/hadsButton2"
                android:layout_width="fill_parent"
                android:text="Local"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                app:backgroundTint="@color/cardcolor"
                android:maxLines="1"
                android:textColor="#ffffff" />

            </LinearLayout>



        </LinearLayout>






    </LinearLayout>



</LinearLayout>
