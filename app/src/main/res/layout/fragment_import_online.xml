<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
	xmlns:android="http://schemas.android.com/apk/res/android" 
	xmlns:app="http://schemas.android.com/apk/res-auto" 
	xmlns:aapt="http://schemas.android.com/aapt" 
	android:orientation="vertical"
	android:background="@color/colorBtn"
	android:layout_width="match_parent" 
	android:layout_height="wrap_content">


	<LinearLayout

		android:padding="15dp"
		android:orientation="vertical"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_margin="0dp"
		android:background="@drawable/targeta">


		<LinearLayout
			android:layout_marginEnd="10dp"
			android:orientation="horizontal"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@drawable/targeta">







			<TextView
				android:textSize="17dp"
				android:textStyle="bold"
				android:textColor="#ffffff"
				android:text="Token del servidor:"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:hint="Payload"/>

			<LinearLayout
				android:orientation="horizontal"
				android:layout_width="match_parent"
				android:gravity="end"
				android:layout_height="fill_parent">
				<ImageView
					android:id="@+id/fragment_import_remoteCancelButton"
					android:src="@drawable/salir"
					android:layout_width="15dp"
					android:layout_height="fill_parent"/>
			</LinearLayout>




		</LinearLayout>




		<LinearLayout
			android:layout_marginTop="5dp"
			android:orientation="horizontal"
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:background="#ffffff">

		</LinearLayout>




	</LinearLayout>

	<TextView
		android:layout_width="wrap_content"
		android:paddingLeft="15dp"
		android:layout_height="wrap_content"
		android:background="#00000000"
		android:text="Ingresa un token de configuracion."
		android:textColor="#ffffff" />

	<TextView
		android:layout_width="wrap_content"
		android:paddingLeft="15dp"
		android:layout_height="wrap_content"
		android:background="#00000000"
		android:text="Ex: 45678435677 "
		android:textColor="#ffffff" />


	
    <com.google.android.material.textfield.TextInputLayout 
		android:id="@+id/box"
		android:padding="15dp"
		android:layout_width="match_parent" 
		android:layout_height="wrap_content"
		style="@style/outlinedTextInputLayout">
		
        <com.google.android.material.textfield.TextInputEditText
			android:hint="Token"
			android:textColor="#ffffff"
			android:id="@+id/fragment_import_online" 
			android:layout_width="match_parent" 
			android:layout_height="wrap_content" 
			android:maxLines="5" 
			android:ems="9" 
			android:inputType="text"/>
			
    </com.google.android.material.textfield.TextInputLayout>
	
	<LinearLayout
		android:layout_height="wrap_content"
		android:layout_width="match_parent"
		android:orientation="horizontal"
		android:gravity="right"
		android:paddingRight="15dp"
		android:paddingBottom="15dp"
		android:layout_marginTop="5dp">






		<Button
			android:drawableLeft="@drawable/ic_clouddescargar"
			android:id="@+id/fragment_import_remoteSaveButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			app:backgroundTint="@color/cardcolor"
			android:text="Importar"
			android:maxLines="1"
			android:textColor="#ffffff" />





			   
	</LinearLayout>
	
</LinearLayout>
