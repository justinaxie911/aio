<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:sweet="http://schemas.android.com/apk/res-auto"
	xmlns:app="http://schemas.android.com/tools"
	android:orientation="vertical"
	android:background="@color/colorPrimaryBackground"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	app:ignore="NamespaceTypo">


	<LinearLayout
		android:orientation="horizontal"
		android:background="@color/colorBtn"
		android:layout_width="match_parent"
		android:layout_height="60dp">


		<ImageView
			android:id="@+id/atras"
			android:padding="15dp"
			android:src="@drawable/ic_backicon"
			android:layout_width="55dp"
			android:layout_height="fill_parent"
			app:tint="#ffffff" />

		<TextView
			android:layout_width="fill_parent"
			android:layout_height="fill_parent"
			android:textColor="#ffffff"
			android:fontFamily="@font/good"
			android:gravity="left|center"
			android:text="Sharet Wi-fi" />

	</LinearLayout>



	<RelativeLayout
		android:layout_marginTop="10dp"
		android:orientation="vertical"
		android:gravity="center"
		android:layout_marginStart="100dp"
		android:layout_marginEnd="100dp"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">

		<ImageView
			android:id="@+id/wifiapagado"
			android:layout_width="wrap_content"
			android:layout_height="80dp"
			android:gravity="center"
			android:src="@drawable/wifiapagado" />
		<ImageView
			android:visibility="gone"
			android:id="@+id/wifiiniciando"
			android:gravity="center"
			android:src="@drawable/wifiiniciando"
			android:layout_width="wrap_content"
			android:layout_height="80dp" />

		<ImageView
			android:visibility="gone"
			android:id="@+id/wifiiniciado"
			android:layout_width="wrap_content"
			android:layout_height="80dp"
			android:gravity="center"
			android:src="@drawable/wifiiniciado" />




	</RelativeLayout>



	<LinearLayout
		android:visibility="visible"
		android:id="@+id/hostport"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginLeft="8dp"
		android:background="@drawable/targeta"
		android:padding="10dp"
		android:layout_marginTop="10dp"
		android:layout_marginRight="8dp"
		sweet:cardCornerRadius="2dp"
		sweet:cardElevation="2dp">

		<LinearLayout
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="70dp">

			<LinearLayout
				android:orientation="horizontal"
				android:layout_width="match_parent"
				android:layout_height="25dp"
				android:layout_margin="5dp">

				<TextView
					android:layout_width="wrap_content"
					android:textColor="#ffffff"
					android:layout_height="match_parent"
					android:text="Nombre de Host:"/>

				<LinearLayout
					android:orientation="horizontal"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:layout_weight="1"/>

				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:gravity="left|center_vertical|center_horizontal|center"
					android:orientation="horizontal"
					android:textColor="#ffffff">

					<TextView
						android:id="@+id/ip_layout"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:layout_marginLeft="15dp"
						android:focusable="true"
						android:autoLink="web"
						android:gravity="center"
						android:longClickable="true"
						android:textColor="#ffffff"
						android:textIsSelectable="true"
						android:textStyle="bold" />

				</LinearLayout>
			</LinearLayout>

			<LinearLayout
				android:orientation="horizontal"
				android:layout_width="match_parent"
				android:layout_height="25dp"
				android:layout_margin="5dp">

				<TextView
					android:textColor="#ffffff"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:text="Puerto Proxy:"/>

				<LinearLayout
					android:orientation="horizontal"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:layout_weight="1"/>

				<TextView
					android:id="@+id/textport"
					android:textIsSelectable="true"
					android:focusable="true"

					android:longClickable="true"
					android:textColor="#ffffff"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:layout_marginLeft="10dp"
					android:text="8080"/>

			</LinearLayout>
		</LinearLayout>

	</LinearLayout>



    <LinearLayout
		android:orientation="vertical"
		android:layout_width="match_parent"
		android:layout_height="match_parent">
		
        <LinearLayout
			android:layout_width="match_parent"
			android:layout_height="80dp"
			android:gravity="center"
			android:layout_marginLeft="8dp"
			android:layout_marginTop="10dp"
			android:layout_marginRight="8dp"
			android:background="@drawable/targeta"
			android:padding="10dp"
			android:orientation="vertical">
			
            <LinearLayout
				android:gravity="center"
				android:layout_gravity="center"
				android:id="@+id/rl_toolbar"
				android:orientation="horizontal"
				android:layout_width="match_parent"
				android:layout_height="75dp"
				android:layout_alignParentTop="true">

				<TextView
					android:id="@+id/tv_info"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:gravity="center"
					android:layout_weight="1"
					android:paddingTop="10dp"
					android:text="Paso 1: Active la Zona Wifi"
					android:paddingBottom="10dp"
					android:textColor="@color/white"
					android:textSize="18sp" />



				<LinearLayout
					android:id="@+id/cardviewwifishared"
					android:clickable="true"
					android:layout_weight="1"
					android:layout_gravity="center"
					android:background="@drawable/targeta"
					android:layout_width="130dp"
					android:layout_height="wrap_content"
					android:layout_marginRight="8dp"
					sweet:cardCornerRadius="2dp"
					sweet:cardElevation="2dp"
					sweet:contentPadding="10dp">

					<LinearLayout
						android:orientation="vertical"
						android:gravity="center"
						android:layout_width="match_parent"
						android:layout_height="wrap_content">

						<ImageView
							android:gravity="center"
							android:src="@drawable/ajustes1"
							android:layout_width="30dp"
							android:layout_height="80dp"
							sweet:tint="#ffffff" />

						<TextView
							android:textStyle="bold"
							android:textColor="#ffffff"
							android:gravity="center_vertical"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginLeft="5dp"
							android:text="Configurar Zona Wi-fi"/>




					</LinearLayout>

				</LinearLayout>

					
            </LinearLayout>
            
			<TextView
				android:id="@+id/tv_demo"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:layout_below="@+id/rl_toolbar"/>
				
        </LinearLayout>
        













		

		
        <LinearLayout
			android:gravity="center"
			android:layout_gravity="center"
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_margin="10dp">
			
            <TextView android:textSize="18sp"
				android:textStyle="bold"
				android:gravity="center"
				android:textColor="#FFEB3B"
				android:paddingTop="10dp"
				android:paddingBottom="10dp"
				android:layout_width="fill_parent"
				android:layout_height="fill_parent"
				android:text="Activar Zona Wi-Fi"/>
				
            <Switch
				android:gravity="center"
				android:id="@+id/cb_enable"
				android:layout_width="70dp"
				app:buttonTint="@drawable/checkbox_filter_tint"
				android:layout_height="60dp"
				android:layout_alignParentRight="true"/>
				
        </LinearLayout>
		
        <LinearLayout
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="200dp"
			android:layout_margin="10dp">
			
            <LinearLayout
				android:gravity="center"
				android:orientation="horizontal"
				android:layout_width="match_parent"
				android:layout_height="30dp">
				
                <TextView
					android:textStyle="bold"
					android:textColor="#ffffff"
					android:gravity="left|center_vertical|center_horizontal|center"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="5dp"
					android:text="Recuerde primero Activar la Zona Wi-Fi"/>
					
            </LinearLayout>
			
            <LinearLayout
				android:gravity="center"
				android:orientation="vertical"
				android:layout_width="match_parent"
				android:layout_height="150dp">
				
                <TextView
					android:textColor="#ffffff"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp" 
					android:text="1. Conecte otro dispositivo a la red WiFi utilizando el SSID / Contraseña."/>
					
                <TextView
					android:textColor="#ffffff"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:text="2. Configure el proxy en el dispositivo conectado."/>
					
                <TextView
					android:textColor="#ffffff"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:text="Guia:"/>
					
                <TextView
					android:textColor="#ffffff"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:text="(Busque en línea cómo configurar el proxy en su dispositivo o consulte esta guía)"/>
					
                <TextView
					android:textColor="#ffffff"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginLeft="10dp"
					android:text="No es necesario instalar esta aplicación y ejecutar Hotshare en el otro dispositivo"/>
					
            </LinearLayout>
			
        </LinearLayout>
		
		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"/>
			
		<!--<com.google.android.gms.ads.AdView
			xmlns:ads="http://schemas.android.com/apk/res-auto"
			android:id="@+id/adView5"
			android:layout_gravity="center"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_centerHorizontal="true"
			android:layout_alignParentBottom="true"
			ads:adSize="BANNER"
			ads:adUnitId="ca-app-pub-6741116462771721/6882526328">
			</com.google.android.gms.ads.AdView>-->
		
    </LinearLayout>
	
</LinearLayout>
