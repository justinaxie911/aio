<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto">
	<PreferenceCategory>

		<com.elcris.coservers.view.SummaryEditTextPreference
			app:iconSpaceReserved="false"
			app:singleLineTitle="false"
			android:title="Secured Shell (SSH)"/>


		<com.elcris.coservers.view.SummaryEditTextPreference
            android:key="sshServer"
            android:title="@string/ssh_server"
            android:summary="none"
            android:dialogMessage=""
			app:iconSpaceReserved="false"
			android:singleLine="true"
			android:dialogLayout="@layout/pref_dialog_edittext_fix" />

		<com.elcris.coservers.view.SummaryEditTextPreference
            android:maxLength="5"
            android:key="sshPort"
            android:title="@string/ssh_port"
			app:iconSpaceReserved="false"
			android:summary="none"
			android:singleLine="true"
			android:dialogLayout="@layout/pref_dialog_number" />


		<com.elcris.coservers.view.SummaryEditTextPreference
			app:iconSpaceReserved="false"
			app:singleLineTitle="false"
			android:title="Información de Cuenta"/>

		<com.elcris.coservers.view.SummaryEditTextPreference
			android:key="sshUser"
			android:title="Usuario"
			app:iconSpaceReserved="false"
			android:summary="none"
			android:dialogMessage=""
			android:singleLine="true"
			android:dialogLayout="@layout/pref_dialog_edittext_fix" />

		<com.elcris.coservers.view.PasswordEditTextPreference
			android:key="sshPass"
			android:title="Contraseña"
			app:iconSpaceReserved="false"
			android:summary="none"
			android:dialogMessage=""
			android:singleLine="true"
			android:dialogLayout="@layout/pref_dialog_edittext_fix" />
	
	</PreferenceCategory>
	


	
	<PreferenceCategory>

		<com.elcris.coservers.view.SummaryEditTextPreference
			app:iconSpaceReserved="false"
			app:singleLineTitle="false"
			android:title="Puerto de reenvio"/>

		<com.elcris.coservers.view.SummaryEditTextPreference
            android:maxLength="5"
            android:key="sshPortaLocal"
            android:title="Puerto local (Socks5)"
            android:summary="1080"
			app:iconSpaceReserved="false"
            android:defaultValue="1080"
			android:singleLine="true"
			android:dialogLayout="@layout/pref_dialog_number" />
		
	</PreferenceCategory>
	
	
</PreferenceScreen>
